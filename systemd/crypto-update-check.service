[Unit]
Description=Check for new crypto-daemon releases, and verify their signatures
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# --check is read-only: it re-pins nothing, restarts nothing, and cannot print
# wallet recovery material or RPC credentials, because those functions live in
# setup.sh.  That is what makes it safe here, where stdout lands in the journal.
# Through bash rather than relying on update.sh's execute bit, which a copy of
# the bundle does not always keep; without it this unit failed every day with
# status 203/EXEC while `sudo bash setup.sh` had worked fine.  Quoted so a
# bundle path containing a space is still one argument.
ExecStart=/bin/bash "@@BUNDLE_DIR@@/update.sh" --check
# Through Arti, so this host's own address is never seen asking GitHub,
# crates.io, Docker Hub and the three download sites the same questions every
# day.  setup.sh run with UPDATE_CHECK_ROUTE=direct adds a drop-in that
# overrides this line and the two IPAddress lines below.
Environment=UPDATE_CHECK_ROUTE=tor
# The kernel's half of that promise: this unit may open a socket to Arti's
# SOCKS address and to nothing else, so a request that somehow skipped the
# proxy fails instead of reaching the clearnet.  Keep the address in step with
# ARTI_SOCKS_HOST in lib.sh.  Nothing here needs DNS -- the proxy resolves
# every name at the exit -- which is why even loopback is left out.
IPAddressDeny=any
IPAddressAllow=10.89.0.10/32
# A non-zero exit is meaningful rather than noise: it means a component could
# not be reached, or that a new release failed its signature threshold and was
# reported BLOCKED.  Both are things worth seeing in `systemctl --failed`.
# 75 means nothing was checked at all, because Arti could not carry a request.
Nice=10
# Up to ten minutes waiting for Arti to build a circuit, then about twenty
# requests that take seconds each over Tor.  Each may run 120s and is tried
# twice, so a run where nearly every one times out is ended here rather than
# waited out; it is reported failed either way.  A Type=oneshot unit has no
# start timeout of its own by default.
TimeoutStartSec=60min

# This unit parses remote input as root once a day.  --check only reads the
# network and writes the verification keyring, so it can be confined tightly.
# That is also why it talks to Arti's SOCKS port across the bridge instead of
# running its requests in a helper container on the internal network: podman
# run needs namespaces, cgroups, /proc/sys and write access to its storage,
# which is every line below.
# The sandbox applies to the timer only: --apply and --redeploy are run by hand
# and rebuild images, which ProtectSystem=strict would refuse outright.
# MemoryDenyWriteExecute and SystemCallFilter are deliberately left off -- they
# are the two most likely to misfire on a future curl or gpg, and a sandbox
# that silently breaks the daily check is worse than a slightly looser one.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
# read-only rather than yes: the unit runs update.sh from wherever the bundle
# was copied, and that is sometimes a home directory.
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/etc/crypto-daemons/keys
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
# AF_NETLINK is not optional: glibc uses it for source-address selection, so
# curl fails to resolve anything without it.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
