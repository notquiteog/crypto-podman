[Unit]
Description=Litecoin Core (all traffic via Arti SOCKS, RPC via onion service)
After=arti.service time-sync.target
# Wants, not Requires: the Tor-only guarantee comes from crypto.network having
# no route out, so this daemon fails closed whether or not Arti is up.  Requires
# would add no safety and would drag this daemon through every Arti restart --
# measured: restarting a required unit restarts its dependents.
Wants=arti.service

[Container]
Image=@@LITECOIN_IMAGE@@
ContainerName=litecoin
Network=crypto.network:ip=10.89.0.12
Volume=/srv/crypto-daemons/litecoin:/data
Volume=/etc/crypto-daemons/litecoin.conf:/etc/litecoin/litecoin.conf:ro
Volume=/etc/crypto-daemons/litecoin-rpcauth.conf:/etc/litecoin/rpcauth.conf:ro
# The published images wrap the daemon in an entrypoint that chowns data and
# re-execs through gosu/fixuid, which needs capabilities this unit drops; the
# Bitcoin/Litecoin ones also append -datadir and would override datadir=/data.
PodmanArgs=--entrypoint litecoind
# Quadlet generates `ExecStop=podman rm -v -f -i` with no -t, so the SIGTERM to
# SIGKILL grace is the container's own stop timeout -- containers.conf default
# 10s -- and not TimeoutStopSec below, which only bounds how long systemd waits
# for that command to return. Ten seconds is not enough to flush a warm cache,
# so set it here, 60s under the unit timeout so podman is not killed mid-stop.
PodmanArgs=--stop-timeout=540
Exec=-conf=/etc/litecoin/litecoin.conf
User=0
NoNewPrivileges=true
# Nothing legitimately writes to the image; all state lives in the mounted
# volumes, so the container root filesystem is read-only.
ReadOnly=true
Tmpfs=/tmp
DropCapability=all
# Report-only liveness; see the note in arti.container before enabling
# HealthOnFailure=kill.  litecoin-cli authenticates with the .cookie the daemon
# writes into /data, so this needs no credentials of its own.  The long start
# period covers the block-index load, during which RPC is not yet answering.
HealthCmd=litecoin-cli -datadir=/data getblockchaininfo
HealthInterval=1m
HealthStartPeriod=15m
HealthTimeout=30s
HealthRetries=3

[Service]
Restart=always
RestartSec=20
TimeoutStopSec=10min

[Install]
WantedBy=multi-user.target
