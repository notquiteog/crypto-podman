[Unit]
Description=Monero default wallet RPC (authenticated onion service)
After=monero.service time-sync.target
Requires=monero.service

[Container]
Image=@@MONERO_IMAGE@@
ContainerName=monero-wallet-rpc
# Internal network only, and never the egress one: this process holds a
# spend-capable wallet and has no business reaching anything but monerod.
Network=crypto.network:ip=10.89.0.14
Volume=/srv/crypto-daemons/monero-wallet:/wallets
Volume=/etc/crypto-daemons/monero-wallet-rpc.conf:/etc/monero-wallet/monero-wallet-rpc.conf:ro
Volume=/etc/crypto-daemons/secrets/monero-wallet-password:/etc/monero-wallet/wallet-password:ro
# The published images wrap the daemon in an entrypoint that chowns data and
# re-execs through gosu/fixuid, which needs capabilities this unit drops; the
# Bitcoin/Litecoin ones also append -datadir and would override datadir=/data.
PodmanArgs=--entrypoint monero-wallet-rpc
Exec=--config-file=/etc/monero-wallet/monero-wallet-rpc.conf
User=0
NoNewPrivileges=true
# Nothing legitimately writes to the image; all state lives in the mounted
# volumes, so the container root filesystem is read-only.
ReadOnly=true
Tmpfs=/tmp
DropCapability=all
# Report-only liveness; see the notes in arti.container and monero.container.
HealthCmd=bash -c "exec 3<>/dev/tcp/127.0.0.1/18088"
HealthInterval=1m
HealthStartPeriod=5m
HealthTimeout=30s
HealthRetries=3

[Service]
Restart=always
RestartSec=20
TimeoutStopSec=5min

[Install]
WantedBy=multi-user.target
