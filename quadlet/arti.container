[Unit]
Description=Arti SOCKS proxy and onion RPC reverse proxies
# time-sync.target matters for the daemons Arti fronts: Tor and both Core
# nodes reject peers whose clocks disagree.  setup.sh enables
# systemd-time-wait-sync so this ordering has something to wait for.
After=network-online.target time-sync.target
Wants=network-online.target

[Container]
Image=@@ARTI_IMAGE@@
ContainerName=crypto-arti
# Dual-homed on purpose.  The internal network carries the daemons that must
# never touch the clearnet; the egress network is the only route out of this
# bundle, and Arti is the only thing on it that speaks Tor.  Quadlet derives the
# Requires=/After= on both network units from these lines.
Network=crypto.network:ip=10.89.0.10
Network=crypto-egress.network:ip=10.89.1.10
Volume=/etc/crypto-daemons/arti.toml:/etc/arti/arti.toml:ro
Volume=/srv/crypto-daemons/arti:/var/lib/arti
Exec=proxy --config /etc/arti/arti.toml
User=0
NoNewPrivileges=true
# Nothing legitimately writes to the image; all state lives in the mounted
# volumes, so the container root filesystem is read-only.
ReadOnly=true
Tmpfs=/tmp
Environment=HOME=/var/lib/arti
DropCapability=all
# Liveness only, and deliberately report-only: a failing check shows up in
# `podman ps` and `systemctl status` but does not restart anything.  Flip
# HealthOnFailure=kill once you have watched a check be accurate on your host;
# a subtly wrong check that restarts a daemon is worse than no check at all.
# bash, not sh: /dev/tcp is a bash builtin and Debian's sh is dash.
# 10.89.0.10, not 127.0.0.1: arti.toml binds SOCKS to this container's bridge
# address only, so nothing is listening on loopback.  Keep these three copies of
# the address -- Network= above, socks_listen in arti.toml, and this line -- in
# step with each other.
HealthCmd=bash -c "exec 3<>/dev/tcp/10.89.0.10/9150"
HealthInterval=1m
HealthStartPeriod=5m
HealthTimeout=20s
HealthRetries=3

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
