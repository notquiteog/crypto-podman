[Unit]
Description=Bitcoin Core (Tor-only, RPC via Arti onion service)
After=arti.service time-sync.target
Requires=arti.service

[Container]
Image=@@BITCOIN_IMAGE@@
ContainerName=bitcoin
Network=crypto.network:ip=10.89.0.11
Volume=/srv/crypto-daemons/bitcoin:/data
Volume=/etc/crypto-daemons/bitcoin.conf:/etc/bitcoin/bitcoin.conf:ro
Volume=/etc/crypto-daemons/bitcoin-rpcauth.conf:/etc/bitcoin/rpcauth.conf:ro
# The published images wrap the daemon in an entrypoint that chowns data and
# re-execs through gosu/fixuid, which needs capabilities this unit drops; the
# Bitcoin/Litecoin ones also append -datadir and would override datadir=/data.
PodmanArgs=--entrypoint bitcoind
# Quadlet generates `ExecStop=podman rm -v -f -i` with no -t, so the SIGTERM to
# SIGKILL grace is the container's own stop timeout -- containers.conf default
# 10s -- and not TimeoutStopSec below, which only bounds how long systemd waits
# for that command to return. Ten seconds is not enough to flush a warm cache,
# so set it here, 60s under the unit timeout so podman is not killed mid-stop.
PodmanArgs=--stop-timeout=540
Exec=-conf=/etc/bitcoin/bitcoin.conf
User=0
NoNewPrivileges=true
# Nothing legitimately writes to the image; all state lives in the mounted
# volumes, so the container root filesystem is read-only.
ReadOnly=true
Tmpfs=/tmp
DropCapability=all
# Report-only liveness; see the note in arti.container before enabling
# HealthOnFailure=kill.  bitcoin-cli authenticates with the .cookie the daemon
# writes into /data, so this needs no credentials of its own.  The long start
# period covers the block-index load, during which RPC is not yet answering.
HealthCmd=bitcoin-cli -datadir=/data getblockchaininfo
HealthInterval=1m
HealthStartPeriod=15m
HealthTimeout=30s
HealthRetries=3

[Service]
Restart=always
RestartSec=20
TimeoutStopSec=10min

[Install]
WantedBy=multi-user.target
