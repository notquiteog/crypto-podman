[Unit]
Description=Monero daemon (Tor-only, restricted RPC via Arti onion service)
After=arti.service time-sync.target
Requires=arti.service

[Container]
Image=@@MONERO_IMAGE@@
ContainerName=monero
Network=crypto.network:ip=10.89.0.13
Volume=/srv/crypto-daemons/monero:/data
Volume=/etc/crypto-daemons/monero.conf:/etc/monero/monerod.conf:ro
# The published images wrap the daemon in an entrypoint that chowns data and
# re-execs through gosu/fixuid, which needs capabilities this unit drops; the
# Bitcoin/Litecoin ones also append -datadir and would override datadir=/data.
PodmanArgs=--entrypoint monerod
# Quadlet generates `ExecStop=podman rm -v -f -i` with no -t, so the SIGTERM to
# SIGKILL grace is the container's own stop timeout -- containers.conf default
# 10s -- and not TimeoutStopSec below, which only bounds how long systemd waits
# for that command to return. Ten seconds is not enough to flush a warm cache,
# so set it here, 60s under the unit timeout so podman is not killed mid-stop.
PodmanArgs=--stop-timeout=540
Exec=--non-interactive --config-file=/etc/monero/monerod.conf
User=0
NoNewPrivileges=true
# Nothing legitimately writes to the image; all state lives in the mounted
# volumes, so the container root filesystem is read-only.
ReadOnly=true
Tmpfs=/tmp
DropCapability=all
# Report-only liveness; see the note in arti.container.  A TCP connect rather
# than an RPC call: monerod's RPC requires the digest credentials appended to
# its config, and a health check that can fail on authentication would report
# a healthy node as sick.  This proves the listener is accepting connections.
HealthCmd=bash -c "exec 3<>/dev/tcp/127.0.0.1/18089"
HealthInterval=1m
HealthStartPeriod=15m
HealthTimeout=30s
HealthRetries=3

[Service]
Restart=always
RestartSec=20
TimeoutStopSec=10min

[Install]
WantedBy=multi-user.target
